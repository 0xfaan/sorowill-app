# ---------------------------------------------------------------------------
# Stellar network to connect to.
# Valid values: "testnet" or "mainnet"
# Defaults to "testnet" if left unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ---------------------------------------------------------------------------
# Deployed SoroWill contract address.
#
# For TESTNET deployments:
#   Set NEXT_PUBLIC_CONTRACT_ID_TESTNET (preferred) or the legacy
#   NEXT_PUBLIC_CONTRACT_ID fallback. Testnet contract IDs are published in:
#   https://github.com/SoroWill/sorowill-contracts/blob/main/deployments/testnet.json
#
# For MAINNET deployments:
#   NEXT_PUBLIC_CONTRACT_ID_MAINNET is REQUIRED and has no fallback.
#   The app refuses to start without it rather than silently pointing at a
#   testnet contract on mainnet. Do NOT reuse a testnet address here.
#
# NEXT_PUBLIC_CONTRACT_ID is kept for backwards-compatible local/testnet
# setups but is intentionally ignored on mainnet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_ID_MAINNET=
NEXT_PUBLIC_CONTRACT_ID_TESTNET=

# Legacy single-var fallback. Used ONLY on testnet when
# NEXT_PUBLIC_CONTRACT_ID_TESTNET is unset. Never used on mainnet.
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_CONTRACT_ID_TESTNET=
NEXT_PUBLIC_CONTRACT_ID_MAINNET=

# ---------------------------------------------------------------------------
# Soroban RPC endpoint for reading on-chain state.
# Defaults to the public testnet RPC if left unset:
#   Testnet: https://soroban-testnet.stellar.org
#   Mainnet: https://soroban-mainnet.stellar.org
# 🔹 You can override per network with NEXT_PUBLIC_RPC_URL_TESTNET
#    and NEXT_PUBLIC_RPC_URL_MAINNET.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# (Optional) Resend API key for sending reminder emails.
# Leave unset to skip email delivery.
# https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# (Optional) Verified Resend sender address used for reminder emails.
# Required when RESEND_API_KEY is set.
# ---------------------------------------------------------------------------
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Reminder subscriptions/history are persisted to a Vercel KV / Upstash
# Redis REST endpoint (required for the reminder register/unsubscribe/
# dispatch routes to work). Vercel's serverless filesystem is ephemeral
# and cannot be used for durable storage.
# Create a Vercel KV store (or an Upstash Redis database) and copy its
# REST URL/token here.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# (Optional) Key used to store the reminder subscriptions/history blob in
# the KV store above. Defaults to "sorowill:reminder-store".
# ---------------------------------------------------------------------------
REMINDER_STORE_KV_KEY=

# ---------------------------------------------------------------------------
# (Optional) Public base URL of this deployment, used to build the
# unsubscribe link included in reminder emails. Defaults to VERCEL_URL
# (when deployed on Vercel) or http://localhost:3000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# (Optional) Bearer token protecting the cron dispatch route.
# When set, requests to /api/reminders/dispatch must include an
# Authorization: Bearer <CRON_SECRET> header.
# ---------------------------------------------------------------------------
CRON_SECRET=
